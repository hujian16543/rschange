# syntax=docker/dockerfile:1
# ============================================================================
# 后端镜像：编译 C++ 引擎 + Python 运行时
#
# 两阶段分离的理由
# ----------------
# 编译引擎需要 g++ / cmake / ninja / libgdal-dev（头文件 + pkg-config），这些
# 在运行期毫无用处。runtime 阶段只保留 GDAL 运行时库，把体积与攻击面同时压
# 下来（手册 task/6.1 明确要求 runtime 只装 libgdal 而非 -dev）。
#
# Python 版本统一为 3.14
# ---------------------
# 旧实现 builder 用 3.12、本机开发用 3.14，两套解释器让 `_spatial` 的 ABI 在
# 两个环境下不同（cp312 vs cp314）。编译产物与运行解释器一旦错配，表现为
# import 期未定义符号，且错误信息指向 Python 而非构建配置。此处两阶段同源。
#
# 版本号说明
# ----------
# base 镜像 tag 与 Debian 发行版代号共同决定 apt 包名。基础镜像 tag 的存在性
# 已由 `scripts/verify_containers.py` 之外的人工核验确认（见
# docs/verification/phase-6.md 的容器化门禁章节）；容器**未在本机构建**，
# 故 apt 包解析路径仅经静态审查，未经运行验证——该限制已在验收报告中披露。
# ============================================================================

# ---------------------------------------------------------------------------
# 阶段 1：编译引擎（builder）
# ---------------------------------------------------------------------------
FROM python:3.14-slim-bookworm AS builder

# uv 二进制来自官方镜像，避免在本阶段装 pip 依赖（uv.lock 是唯一真相源）。
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# 编译期系统依赖。与下一层分离，使改源码时不必重装工具链。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

# 先按锁文件装依赖（源码未复制，此处只装第三方包）。
COPY pyproject.toml uv.lock ./
COPY backend/pyproject.toml backend/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --frozen --no-install-project

# 再复制源码并安装本工程自身。
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --all-packages --frozen

# 编译引擎。Python_EXECUTABLE 必须显式指向 venv，否则 find_package(Python)
# 会解析到镜像自带的 /usr/local/bin/python3（同一套安装故不报错，但扩展会
# 装进系统 site-packages 而非 venv，运行期导入不到）。
WORKDIR /app/engine
RUN cmake --preset dev-linux -DPython_EXECUTABLE=/app/.venv/bin/python \
    && cmake --build --preset dev-linux

# ---------------------------------------------------------------------------
# 阶段 2：运行时（runtime）
# ---------------------------------------------------------------------------
FROM python:3.14-slim-bookworm AS runtime

# GDAL 运行时库。
#
# Debian 不为 GDAL 提供无版本的包名（只有带 soname 的 libgdalNN），包名随
# 发行版变化：bookworm 是 libgdal32，trixie 是 libgdal35。写死其一会在基础
# 镜像换代时静默失效，故逐个尝试并显式失败。
#
# 禁止退回 `apt-get install libgdal-dev`：那会把整套编译期头文件与 pkg-config
# 拖进运行镜像，正是本阶段要避免的。
RUN set -eux; \
    apt-get update; \
    installed=""; \
    for pkg in libgdal36 libgdal35 libgdal34 libgdal33 libgdal32; do \
        if apt-get install -y --no-install-recommends "$pkg"; then installed="$pkg"; break; fi; \
    done; \
    if [ -z "$installed" ]; then \
        echo "未能在本基础镜像中定位 GDAL 运行时包（libgdalNN）" >&2; \
        exit 1; \
    fi; \
    echo "已安装 GDAL 运行时包：$installed"; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制虚拟环境、源码与编译产物。
# .venv 内的 editable 安装指向 /app/backend/src，故两阶段的 WORKDIR 必须同为
# /app，否则运行期导入 rschange 失败。
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/backend /app/backend
COPY --from=builder /app/engine/build/dev-linux/_spatial*.so /app/engine/build/dev-linux/
COPY --from=builder /app/engine/build/dev-linux/libspatial.so* /app/engine/build/dev-linux/
COPY config/default.toml /app/config/default.toml

# 运行期配置。
#
# host 必须覆盖为 0.0.0.0：default.toml 的 127.0.0.1 是开发机取值，容器内
# 绑定回环地址会让端口映射失效（宿主看不到该端口）。
# engine.build_dir 指向镜像内的编译产物目录，覆盖 default.toml 的 dev-win。
ENV PATH=/app/.venv/bin:$PATH \
    RSCHANGE_RUNTIME__HOST=0.0.0.0 \
    RSCHANGE_RUNTIME__PORT=8000 \
    RSCHANGE_RUNTIME__DATA_DIR=/app/data \
    RSCHANGE_ENGINE__BUILD_DIR=/app/engine/build/dev-linux

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/data/uploads /app/data/outputs \
    && chown -R appuser:appuser /app/data
USER appuser

EXPOSE 8000

# 健康检查直接打根路由：它不触碰引擎，能在引擎故障时仍区分「进程活着」与
# 「依赖就绪」两件事。
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/', timeout=3).status == 200 else 1)"

# 用 `-m rschange.api.app` 而非 `uvicorn rschange.api.app:create_app`：
# 前者经 app.py 的 main() 读配置决定 host/port，与本地开发路径完全一致；
# 后者要求命令行再复述一遍 host/port，两处取值必然漂移。
CMD ["python", "-m", "rschange.api.app"]
