{
  "name": "rschange-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format:check": "oxlint --format=github",
    "test": "vitest run",
    "check": "tsc -b --noEmit && oxlint && vitest run",
    "preview": "vite preview",
    "gen:types": "swagger-typescript-api generate -p ../docs/api/openapi.json -o src/api/generated --modular --no-client --type-only-imports --sort-types"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "oxlint": "^1.75.0",
    "swagger-typescript-api": "^13.13.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}
