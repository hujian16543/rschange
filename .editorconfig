# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{ts,tsx,js,jsx,json,jsonc,yml,yaml,html,css}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{ps1,psm1}]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab

[*.toml]
indent_size = 2
